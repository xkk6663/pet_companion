# 必填：设备侧请求头 X-Music-Token 要带这个值。生成：openssl rand -hex 16
MUSIC_TOKEN=change-me-please

# 监听地址/端口（容器内保持 0.0.0.0:8080，宿主机端口在 compose 里映射）
HOST=0.0.0.0
PORT=8080

# 自建网易云 NodeJS API 地址（docker compose 内部网络）
#   用 compose 的 netease-api 服务时填：http://netease-api:3000
#   不用自建就留空（只剩第三方解析站，稳定性差一个档）
NETEASE_API=

# 音源优先级，逗号分隔，从左到右先试
#   留空的源会被自动跳过（NETEASE_API 为空时 netease 自动禁用）
SOURCE_ORDER=netease,gdstudio,qijieya

# 每 IP 每分钟请求上限（含搜索/取链/下载）
RATE_PER_MIN=120

# 单次搜索最多返回条数（设备一般只要 3~5）
MAX_LIMIT=10

# 单个上游请求超时（秒）
UPSTREAM_TIMEOUT=8

# 出站代理，一般不用。本机调试走 Clash 时填 http://127.0.0.1:7891
# HTTP_PROXY_OUT=
