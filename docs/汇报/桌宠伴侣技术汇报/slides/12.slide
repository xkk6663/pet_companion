<Slide style={{ width: 1280, height: 720, padding: '60px 60px', background: '#FFFFFF', fontFamily: 'Microsoft YaHei', display: 'flex', flexDirection: 'column' }}>
    <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>11 种帧，就是两端之间的全部协议</Text>
        <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 1 }}>03 / 端云契约</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 14 }} />

    <Box style={{ display: 'flex', flexDirection: 'row', gap: 32, marginTop: 18 }}>

        <Box style={{ width: 268, display: 'flex', flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2563EB', letterSpacing: 1 }}>三条设计纪律</Text>
            <Box style={{ width: '100%', height: 1, background: '#DBEAFE', marginTop: 12, marginBottom: 16 }} />
            <Text style={{ fontSize: 15, color: '#1E293B', lineHeight: 1.5, fontWeight: 'bold' }}>单行 JSON，一行一帧</Text>
            <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.5, marginTop: 6 }}>
                设备按对象括号配对切帧，不依赖换行符
            </Text>
            <Box style={{ width: 24, height: 1, background: '#E2E8F0', marginTop: 18, marginBottom: 18 }} />
            <Text style={{ fontSize: 15, color: '#1E293B', lineHeight: 1.5, fontWeight: 'bold' }}>大对象只给 URL</Text>
            <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.5, marginTop: 6 }}>
                音频、图片走 HTTP 拉取，不挤占长连接带宽
            </Text>
            <Box style={{ width: 24, height: 1, background: '#E2E8F0', marginTop: 18, marginBottom: 18 }} />
            <Text style={{ fontSize: 15, color: '#1E293B', lineHeight: 1.5, fontWeight: 'bold' }}>地址只写一遍</Text>
            <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.5, marginTop: 6 }}>
                云端只发相对路径，设备自己补 http base
            </Text>
        </Box>

        <Box style={{ flex: 1, border: '1px solid #E2E8F0', borderRadius: 8, padding: '4px 20px' }}>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 38, borderBottom: '1px solid #E2E8F0' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#64748B', width: 236 }}>帧类型</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#64748B', width: 78 }}>方向</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#64748B', flex: 1 }}>作用 / 设备落点</Text>
            </Box>

            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>caps</Text>
                <Text style={{ fontSize: 15, color: '#EA580C', width: 78 }}>↑</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>能力自述：这台设备会干什么 → ai_action 上报</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>pcm</Text>
                <Text style={{ fontSize: 15, color: '#EA580C', width: 78 }}>↑</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>语音上行（16k / mono / 裸 PCM）→ voice_service</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>text</Text>
                <Text style={{ fontSize: 15, color: '#64748B', width: 78 }}>↑ ↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>文字回合 / 回复文本（role=0 是识别回显）→ 气泡</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>event.action_result</Text>
                <Text style={{ fontSize: 15, color: '#EA580C', width: 78 }}>↑</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>动作执行回执，让云端的同步调用拿到真实结论</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>image_req</Text>
                <Text style={{ fontSize: 15, color: '#EA580C', width: 78 }}>↑</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>拍照问：触发视觉问答 → ai_camera</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>action</Text>
                <Text style={{ fontSize: 15, color: '#0891B2', width: 78 }}>↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>云端指挥设备做事 → ai_action_dispatch</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>system</Text>
                <Text style={{ fontSize: 15, color: '#0891B2', width: 78 }}>↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>系统指令：音量 / 拍照 / 打卡 / 台灯 / 重启 → event_bus</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>emotion</Text>
                <Text style={{ fontSize: 15, color: '#0891B2', width: 78 }}>↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>表情 / 嘴型状态 → pet_overlay</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>audio</Text>
                <Text style={{ fontSize: 15, color: '#0891B2', width: 78 }}>↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>TTS 音频 URL → xiaozhi_service（优先级 2 通道）</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40, borderBottom: '1px solid #F8FAFC' }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>image</Text>
                <Text style={{ fontSize: 15, color: '#0891B2', width: 78 }}>↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>表情包 / 配图 URL → cloud_media_service 下载解码</Text>
            </Box>
            <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'center', height: 40 }}>
                <Text style={{ fontSize: 16, color: '#2563EB', width: 236, fontFamily: 'Consolas' }}>error</Text>
                <Text style={{ fontSize: 15, color: '#0891B2', width: 78 }}>↓</Text>
                <Text style={{ fontSize: 15, color: '#1E293B', flex: 1 }}>失败可见：把原因告诉用户，而不是静默</Text>
            </Box>
        </Box>
    </Box>
</Slide>
